# ----------------------------------------------------
# Goalivo (wideget-core 통합 앱)
# Vercel 환경 변수에 아래 값들을 등록하세요.
# 이 파일은 로컬 참고용이며, 실제 키 값은 넣지 마세요.
# ----------------------------------------------------

# 1. Supabase 접속 정보 (wideget-core 프로젝트 기준 · 필수)
#    표준 변수명 (권장)
NEXT_PUBLIC_SUPABASE_URL=https://[wideget-core_프로젝트_ID].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUz...

#    service_role key: 서버(api/*)에서만 사용. 절대 프론트엔드/클라이언트로 노출 금지.
#    (Goalivo 프론트엔드는 /api/config 를 통해 URL/anon key만 받습니다.)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUz...service_role...

#    (레거시 호환) 아래 이름도 계속 인식됩니다. 표준 변수명으로 이전을 권장합니다.
# SUPABASE_URL=https://[wideget-core_프로젝트_ID].supabase.co
# SUPABASE_ANON_KEY=eyJhbGciOiJIUz...

# 2. AI API Keys (서버 전용 · 프론트엔드 노출 금지)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# 3. (선택) AI 모델 오버라이드
# OPENAI_MODEL=gpt-4o
# OPENAI_WEB_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL=gpt-image-2
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
